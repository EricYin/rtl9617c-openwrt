diff --git a/drivers/net/phy/realtek/Kconfig b/drivers/net/phy/realtek/Kconfig
index 23d453c86..146324298 100644
--- a/drivers/net/phy/realtek/Kconfig
+++ b/drivers/net/phy/realtek/Kconfig
@@ -13,4 +13,13 @@ config REALTEK_PHY_HWMON
 	help
 	  Optional hwmon support for the temperature sensor
 
+config REALTEK_PHY_HISGMII
+	bool "RTL8221B HiSGMII mode support"
+	depends on OF
+	select FW_LOADER
+	help
+	  Support for the RTL8221B 2.5G PHY in HiSGMII mode, used when the
+	  PHY node has the "realtek,hisgmii" property. The PHY patch is
+	  loaded from firmware.
+
 endif # REALTEK_PHY
diff --git a/drivers/net/phy/realtek/Makefile b/drivers/net/phy/realtek/Makefile
index a35e3e3c0..6b13f5f03 100644
--- a/drivers/net/phy/realtek/Makefile
+++ b/drivers/net/phy/realtek/Makefile
@@ -2,5 +2,6 @@
 realtek-y			+= realtek_main.o
 realtek-y			+= phy_patch.o
 realtek-y			+= phy_patch_rtl826x.o
+realtek-$(CONFIG_REALTEK_PHY_HISGMII) += realtek_hisgmii.o
 realtek-$(CONFIG_REALTEK_PHY_HWMON) += realtek_hwmon.o
 obj-$(CONFIG_REALTEK_PHY)	+= realtek.o
