+void rtw89_phy_route_rfe_gpio(struct rtw89_dev *rtwdev, enum rtw89_rf_path path,
+			      u8 gpio_idx, bool inv, u8 src_sel)
+{
+	u32 path_ofst = path == RF_PATH_A ? 0 : 0x2000;
+	u32 addr, mask;
+
+	if (gpio_idx >= 32)
+		return;
+
+	addr = R_RFE_SEL0_A2 + (gpio_idx / 16) * sizeof(u32);
+	mask = B_RFE_SEL0_MASK << (gpio_idx % 16) * 2;
+	rtw89_phy_write32_mask(rtwdev, addr, mask, path);
+
+	rtw89_phy_write32_mask(rtwdev, R_RFE_INV0 + path_ofst, BIT(gpio_idx), inv);
+
+	addr = R_RFE_SEL0_BASE + path_ofst + (gpio_idx / 8) * sizeof(u32);
+	mask = B_RFE_SEL0_SRC_MASK << (gpio_idx % 8) * 4;
+	rtw89_phy_write32_mask(rtwdev, addr, mask, src_sel);
+
+	addr = R_AX_GPIO0_7_FUNC_SEL + gpio_idx / 2;
+	mask = GENMASK(3, 0) << (gpio_idx % 2) * 4;
+	rtw89_write8_mask(rtwdev, addr, mask, BIT(3));
+}
+EXPORT_SYMBOL(rtw89_phy_route_rfe_gpio);
