. /lib/functions/uci-defaults.sh

board_config_update

board=$(board_name)

case "$board" in
youhua,pt1500-h10-2p5g)
    ucidef_set_led_netdev "wan" "WAN" "LED_PPP_G" "pppoe-wan"
    ucidef_set_led_netdev "lan1" "LAN1" "4f4329118.mdio:06:blue:lan" "lan1"
    ucidef_set_led_netdev "lan2" "LAN2" "LED_EPHY1" "lan2"
    ucidef_set_led_netdev "lan3" "LAN3" "LED_EPHY2" "lan3"
    ucidef_set_led_netdev "lan4" "LAN4" "LED_EPHY3" "lan4"
	;;
esac

board_config_flush

exit 0
