'use strict';
import { readfile } from 'fs';

function read_value(path) {
	let text = readfile(path);
	return text == null ? null : trim(text);
}

function network_ports() {
	let ports = [];
	for (let name in ['lan1', 'lan2', 'lan3', 'lan4', 'pon0']) {
		let path = '/sys/class/net/' + name + '/';
		let port = { device: name, present: read_value(path + 'ifindex') != null };
		for (let key in ['carrier', 'operstate', 'speed', 'duplex', 'address', 'mtu'])
			port[key] = read_value(path + key);
		port.statistics = {};
		for (let key in ['rx_bytes', 'tx_bytes', 'rx_packets', 'tx_packets',
			'rx_errors', 'tx_errors', 'rx_dropped', 'tx_dropped'])
			port.statistics[key] = read_value(path + 'statistics/' + key);
		push(ports, port);
	}
	return ports;
}

function fields(text) {
	if (text == null)
		return null;
	let result = {};
	for (let token in split(trim(text), /\s+/)) {
		let position = index(token, '=');
		if (position > 0)
			result[substr(token, 0, position)] = substr(token, position + 1);
	}
	return result;
}

function uptime_ms() {
	return +split(trim(readfile('/proc/uptime')), ' ')[0] * 1000;
}

function status_live(status, now_ms) {
	if (type(status.pid) != 'int' || status.pid <= 0 || type(status.updated_ms) != 'int')
		return false;
	// /proc/uptime is truncated to centiseconds; compare at the same resolution
	// and allow tiny skew between daemon write and proc read.
	let updated_ms = status.updated_ms - status.updated_ms % 10;
	let process = readfile('/proc/' + status.pid + '/stat');
	let end = process != null ? index(process, ') ') : -1;
	let state = end >= 0 ? split(substr(process, end + 2), ' ') : [];
	let recent = now_ms >= updated_ms ? (now_ms - updated_ms < 5000) : (updated_ms - now_ms <= 200);
	return length(state) > 19 && state[0] != 'Z' && state[0] != 'X' &&
		state[19] == status.process_start && recent;
}

function omci_status() {
	let status = fields(readfile('/var/run/pon-omci'));
	if (status == null)
		return null;
	status.pid = +status.pid;
	status.updated_ms = +status.updated_ms;
	status.live = status_live(status, uptime_ms());
	return status;
}

function llid_entries() {
	let table = readfile('/sys/bus/platform/devices/4f5500000.pon/llid_table');
	let entries = {};
	if (table == null)
		return entries;
	for (let line in split(trim(table), '\n')) {
		// Hardware LLID values and the local session index are different.
		let hex = match(line, /llid=([0-9a-fA-F]{4})/);
		let idx = match(line, /index=([0-9]+)/);
		if (hex != null && idx != null)
			entries[+idx[1]] = +('0x' + hex[1]);
	}
	return entries;
}

function oam_ports() {
	let raw = [];
	let llids = llid_entries();
	for (let llid = 0; llid < 32; llid++) {
		let text = readfile('/var/run/pon-oam/llid-' + llid + '.json');
		if (text == null)
			continue;
		let status;
		try { status = json(text); }
		catch (e) { continue; }
		if (type(status) != 'object' || type(status.pid) != 'int' || status.pid <= 0)
			continue;
		status.llid_index = llid;
		push(raw, status);
	}
	if (!length(raw))
		return [];
	let now_ms = uptime_ms();
	let ports = [];
	for (let status in raw) {
		let llid = status.llid_index;
		status.live = status_live(status, now_ms);
		status.llid = status.live && status.registered && llids[llid] != null ? llids[llid] : null;
		if (!status.live) {
			status.registered = false;
			status.auth_state = null;
			status.auth_succeeded = false;
			status.auth_source = "none";
			status.auth_success_ms = 0;
			status.auth_duration_ms = 0;
			status.auth_succ_time = 0;
			status.discovery_stable = false;
		}
		push(ports, status);
	}
	return ports;
}

function fe_paths() {
	let text = readfile('/sys/kernel/debug/4f4300000.ethernet/flows');
	if (text == null)
		return null;
	let up = { flows: 0, ipv4: 0, ipv6: 0, packets: 0, bytes: 0 };
	let down = { flows: 0, ipv4: 0, ipv6: 0, packets: 0, bytes: 0 };
	let br = { flows: 0, packets: 0, bytes: 0 };
	let ports = {};
	let entries = [];
	for (let line in split(trim(text), '\n')) {
		if (line == '')
			continue;
		let f = fields(line);
		if (+(f.deleting || 0))
			continue;
		let kind = split(trim(line), /\s+/)[0];
		let inif = f.in || '';
		let outif = f.out || '';
		let pkts = +(f.packets || 0);
		let b = +(f.bytes || 0);
		let learned = +(f.learned || 0);
		push(entries, {
			k: kind, in: inif, out: outif,
			h: +(f.hash || 0), c: +(f.counter || 0),
			p: pkts, b: b, l: learned
		});
		let in_pon = substr(inif, 0, 3) == 'pon';
		let out_pon = substr(outif, 0, 3) == 'pon';
		if (kind == 'bridge' || learned || (!in_pon && !out_pon)) {
			br.flows++;
			br.packets += pkts;
			br.bytes += b;
			continue;
		}
		if (out_pon && !in_pon) {
			up.flows++;
			up.packets += pkts;
			up.bytes += b;
			if (kind == 'ipv6') up.ipv6++; else up.ipv4++;
			if (inif != '') {
				ports[inif] ??= { up: 0, down: 0 };
				ports[inif].up++;
			}
		} else if (in_pon && !out_pon) {
			down.flows++;
			down.packets += pkts;
			down.bytes += b;
			if (kind == 'ipv6') down.ipv6++; else down.ipv4++;
			if (outif != '') {
				ports[outif] ??= { up: 0, down: 0 };
				ports[outif].down++;
			}
		}
	}
	sort(entries, function(a, b) {
		let ac = (a.b > 0 || a.p > 0) ? 1 : 0;
		let bc = (b.b > 0 || b.p > 0) ? 1 : 0;
		if (ac != bc)
			return bc - ac;
		if (a.b != b.b)
			return b.b - a.b;
		if (a.p != b.p)
			return b.p - a.p;
		return a.h - b.h;
	});
	return {
		upstream: up,
		downstream: down,
		bridge: br,
		ports: ports,
		total_entries: length(entries),
		entries: slice(entries, 0, 128)
	};
}

const methods = {
	status: {
		call: function() {
			const device = '/sys/bus/platform/devices/4f5500000.pon/';
			const data_path = readfile(device + 'data_path');
			return {
				identity: {
					onu_mac: read_value(device + 'onu_mac'),
					serial_number: read_value(device + 'active_serial_number')
				},
				service: fields(readfile('/var/run/pon-service')),
				activation: fields(readfile(device + 'activation')),
				data_path: fields(data_path == null ? null : split(data_path, '\n')[0]),
				data_path_raw: data_path,
				omci: omci_status(),
				state: fields(readfile(device + 'state')),
				serdes: fields(readfile(device + 'serdes')),
				bosa: fields(readfile(device + 'bosa')),
				mac: fields(readfile(device + 'mac')),
				mpcp: fields(readfile(device + 'mpcp')),
				traffic: fields(readfile(device + 'traffic')),
				optical: fields(readfile(device + 'optical')),
				transceiver: fields(readfile(device + 'transceiver')),
				fec: fields(readfile(device + 'fec')),
				fe: fields(readfile(device + 'fe')),
				fe_paths: fe_paths(),
				puc: readfile(device + 'puc'),
				pdc: readfile(device + 'pdc'),
				llids: readfile(device + 'llid_table'),
				deepq: fields(readfile('/sys/bus/platform/devices/4f4300000.ethernet/pon_deepq')),
				wan_rx_packets: trim(readfile('/sys/class/net/pon0/statistics/rx_packets')),
				wan_tx_packets: trim(readfile('/sys/class/net/pon0/statistics/tx_packets')),
				lan_rx_errors: trim(readfile('/sys/class/net/lan1/statistics/rx_errors')),
				lan_rx_dropped: trim(readfile('/sys/class/net/lan1/statistics/rx_dropped')),
				oam_ports: oam_ports(),
				ports: network_ports(),
				uptime_ms: uptime_ms(),
				queried_at: time()
			};
		}
	}
};

return { 'luci.rtl9617c-pon': methods };
